# Environment variables for Thrivelens
# Copy to .env and fill in your values. Do not commit .env.

# OpenAI API (Required for UX analysis)
NUXT_OPENAI_API_KEY=

# ThriveCart API (Required for ThriveCart MCP tools)
NUXT_THRIVECART_BASE_URL=https://thrivecart.com
# NUXT_THRIVECART_BASE_URL=https://staging.thrivecart.com
NUXT_THRIVECART_API_KEY=

# Optional future integrations:
# NUXT_STRIPE_API_KEY=
